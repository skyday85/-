{
  "contract_version": "1.1",
  "purpose": "Standard exchange envelope for all applications and specialized agents connected to the Main Agent",
  "required_envelope_fields": [
    "source_system",
    "source_record_id",
    "record_type",
    "occurred_at",
    "updated_at",
    "payload"
  ],
  "optional_cross_ids": [
    "business_case_id",
    "customer_id",
    "lead_id",
    "deal_id",
    "order_id",
    "execution_id",
    "vehicle_id",
    "counterparty_id",
    "invoice_id",
    "transaction_id",
    "purchase_id",
    "email_id",
    "attachment_id",
    "campaign_id",
    "task_id",
    "incident_id",
    "plan_item_id"
  ],
  "agent_context_fields": [
    "agent_id",
    "parent_agent_id",
    "delegated_by",
    "delegation_reason"
  ],
  "link_status": ["confirmed", "suggested", "needs_review", "rejected"],
  "data_ownership": "source_application",
  "main_agent_direct_database_access": false,
  "specialized_agent_direct_database_access": false,
  "audit_required": true,
  "security_control_external": true,
  "orchestration": {
    "root_agent": "main_agent",
    "specialized_agents": [
      "buyer_agent",
      "mail_collector_agent",
      "finance_agent",
      "sales_agent",
      "marketing_agent"
    ],
    "cross_domain_coordination_via_main_agent": true
  },
  "example": {
    "source_system": "mail_collector",
    "source_record_id": "mail-123",
    "record_type": "supplier_invoice_email",
    "occurred_at": "2026-09-08T12:00:00+03:00",
    "updated_at": "2026-09-08T12:01:00+03:00",
    "business_case_id": "case-purchase-001",
    "purchase_id": "purchase-521",
    "email_id": "mail-123",
    "attachment_id": "attachment-17",
    "link_status": "suggested",
    "agent_id": "mail_collector_agent",
    "parent_agent_id": "main_agent",
    "payload": {}
  }
}
