# Public/internal base URL of the fleet-management application.
# HTTP is allowed only for localhost development.
FLEET_API_BASE_URL="http://localhost:3000"

# Must equal MAIN_AGENT_API_KEY configured in fleet-management.
# Store the real value only in the deployment secret store; never commit it.
FLEET_MAIN_AGENT_API_KEY=""

# Unified Mac/iPhone HTTP API.
APP_ENV="development"
PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
PUBLIC_CLIENT_BASE_URL="http://localhost:1420"
APP_ALLOWED_ORIGINS="http://localhost:1420,http://127.0.0.1:1420"

# Production authentication is expected from a trusted authenticated reverse proxy.
# The API rejects anonymous requests outside local development.

# External mail gateway. It owns Gmail/Microsoft OAuth client secrets and refresh tokens.
# Production URL must use HTTPS. The token belongs in a secret store.
MAIL_GATEWAY_BASE_URL=""
MAIL_GATEWAY_SERVICE_TOKEN=""
