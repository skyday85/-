# Mail gateway runtime
APP_ENV="development"
MAIL_GATEWAY_SERVICE_TOKEN=""
MAIL_GATEWAY_ENCRYPTION_KEY=""
MAIL_GATEWAY_TOKEN_STORE="./var/mail_tokens.bin"

# Google OAuth web application
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Microsoft Entra application
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
# common supports organizational and personal Microsoft accounts. Narrow this to a tenant ID if required.
MICROSOFT_OAUTH_TENANT="common"
